`define SIGMOID_VALUES_FILE ""
module sigmoid 
#(
INPUT_WIDTH = 5,
OUTPUT_WIDTH = 16, 
SIGMOID_FILE 
)
(
  input [INPUT_WIDTH-1:0] data_in; 
  output [OUTPUT_WIDTH-1:0] data_out; 
)
  reg [OUTPUT_WIDTH-1:0] mem [0:INPUT_WIDTH-1]; 
  inital
  begin 
    $readmemb(SIGMOID_VALUES_FILE,mem); 
  end 
  
  //combinational read infers DRAM 
  always@(*)
  begin 
    data_out = data_in 
  end 

endmodule 
