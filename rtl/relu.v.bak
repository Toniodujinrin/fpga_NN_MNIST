module relu
#(
  parameter 
  INPUT_WIDTH = 32, 
  OUTPUT_WIDTH = 16
)
(
  input [WIDTH-1:0] data_in, 
  output [OUTPUT_WIDTH-1:0] data_out
)
  always@(*)
  begin 
    if(data_in < 0)
      begin 
        data_out <= data_in[INPUT_WIDTH-1-:OUTPUT_WIDTH]; 
      end 
    else
      begin 
        data_out <= {OUTPUT_WIDTH{1'b0}}; 
  end 
endmodule 
